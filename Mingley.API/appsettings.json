{
  "App": {
    "Environment": "Production",
    "Url": "http://0.0.0.0:10000"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=RENDER_DB_HOST;Port=5432;Database=RENDER_DB_NAME;Username=RENDER_DB_USER;Password=RENDER_DB_PASS"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_ENV_VAR",
    "Issuer": "MingleyAPI",
    "Audience": "MingleyApp"
  },
  "Agora": {
    "AppId": "REPLACE_WITH_ENV_VAR",
    "AppCertificate": "REPLACE_WITH_ENV_VAR"
  },
  "Razorpay": {
    "KeyId": "REPLACE_WITH_ENV_VAR",
    "KeySecret": "REPLACE_WITH_ENV_VAR"
  },
  "Firebase": {
    "ProjectId": "REPLACE_WITH_ENV_VAR",
    "ServiceAccountKey": "REPLACE_WITH_ENV_VAR"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:10000"
      }
    }
  }
}

